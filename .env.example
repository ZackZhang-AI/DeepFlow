# DeepFlow 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ============================================
# 模型 API (DeepSeek)
# ============================================
# DeepSeek API Key (从 platform.deepseek.com 获取)
# ============================================
# Demo deployment controls (Vercel + Render)
# ============================================
# 启动时幂等写入公开报告与私域知识库样例；本地开发默认关闭。
DEMO_SEED_ENABLED=false
# 公开只读样例的固定分享 token，不是登录凭证。
DEMO_SHARE_TOKEN=deepflow-showcase
# Frontend/Vercel only: must match DEMO_SHARE_TOKEN on Render.
NEXT_PUBLIC_DEMO_SHARE_TOKEN=deepflow-showcase
# Render persistent disk path, e.g. /var/data/deepflow.db
DEEPFLOW_DB_PATH=
# 本地默认演示账号；公开部署时必须改成平台 Secret 中的强密码。
ALLOW_PUBLIC_REGISTRATION=true
DEMO_USERNAME=deepflow
DEMO_PASSWORD=DeepFlow2026!
# Set true on public deployments unless Docker sandbox isolation is available.
DISABLE_SANDBOX_TOOL=true
# Required when enabling the sandbox; use an image containing approved analysis packages if needed.
DEEPFLOW_SANDBOX_IMAGE=python:3.12-slim
# CORS should be the exact Vercel origin in production, e.g. https://deepflow-demo.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Frontend/Vercel only: point the Next.js app at the Render backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# Demo abuse/cost limits
# ============================================
RATE_LIMIT_WINDOW_SECONDS=3600
RESEARCH_TASK_RATE_LIMIT_PER_HOUR=20
TOOL_TEST_RATE_LIMIT_PER_HOUR=30
KNOWLEDGE_WRITE_RATE_LIMIT_PER_HOUR=20
ARTIFACT_RATE_LIMIT_PER_HOUR=20
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# 模型 API (阿里百炼 - 备选 Reporter)
# ============================================
# 阿里百炼 API Key (从 dashscope.aliyun.com 获取)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ============================================
# 搜索 API (Tavily)
# ============================================
# Tavily API Key (从 tavily.com 获取，免费 1000 credits/月)
TAVILY_API_KEY=tvly-your-tavily-api-key

# ============================================
# 搜索 API (SerpAPI - 备用)
# ============================================
# SerpAPI API Key (从 serpapi.com 获取，免费 250 次/月)
SERPAPI_API_KEY=your-serpapi-api-key

# ============================================
# 模型配置
# ============================================
# Planner 模型
PLANNER_MODEL=deepseek-v4-flash
# Researcher 模型
RESEARCHER_MODEL=deepseek-v4-flash
# Reporter 模型 (快速档自动使用 Flash，标准/深度档使用此模型)
REPORTER_MODEL=deepseek-v4-pro
# Reporter 备选模型
REPORTER_FALLBACK_MODEL=qwen-max
# V4 默认关闭思考模式，以降低费用并稳定结构化输出
DEEPSEEK_THINKING_ENABLED=false
# 仅用于人民币费用估算，不影响 Provider 实际结算
USD_TO_CNY_RATE=7.2

# ============================================
# Embedding / 知识库 RAG 配置
# ============================================
# auto: 有 DASHSCOPE_API_KEY 时使用云 embedding，否则使用零成本本地 hashing embedding
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v2
KNOWLEDGE_TOP_K=5
KNOWLEDGE_CANDIDATE_K=20
KNOWLEDGE_SCORE_THRESHOLD=0.20
KNOWLEDGE_VECTOR_WEIGHT=0.70
KNOWLEDGE_KEYWORD_WEIGHT=0.30
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=200
ENABLE_KB_RERANK=false
KB_RERANK_MODEL=gte-rerank-v2
KB_RERANK_TOP_N=5

# ============================================
# 研究配置
# ============================================
# 最大研究步骤数
MAX_STEPS=8
# 每步最大搜索次数
MAX_SEARCH_CALLS=4
# 每步最大抓取页面数
MAX_CRAWL_PAGES=4
# 单次研究最大 token 预算
MAX_TOKEN_BUDGET=160000
# 最大重试次数
MAX_RETRIES=2
